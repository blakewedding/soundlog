# ---------- Core ----------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# ---------- Database ----------
DATABASE_URL=postgresql://soundlog:soundlog@localhost:5432/soundlog

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Elasticsearch ----------
ELASTICSEARCH_NODE=http://localhost:9200

# ---------- Auth ----------
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# THE APP ORIGIN — where the browser actually loads the app. One origin serves
# the SPA and /api (Vite proxies it in dev, nginx in production), so the refresh
# cookie is same-origin by construction. Also where OAuth hands the browser back.
#
# `localhost`, NOT `127.0.0.1`: browsers treat them as separate cookie origins,
# so a session started on one is invisible on the other — the app renders
# logged-out and it looks like a broken session. The provider callbacks below
# stay on 127.0.0.1 (Spotify requires a literal loopback IP) and that is safe:
# that leg sets no cookie, it mints a one-time code and redirects here.
CLIENT_URL=http://localhost:3000

# ---------- Spotify ----------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4000/api/auth/spotify/callback

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4000/api/auth/google/callback

# ---------- Resend (transactional email) ----------
# Optional. Leave blank in development: sends become a logged no-op, which is
# usually what you want locally. To exercise a real send, mint a key and use
# Resend's onboarding@resend.dev sender — the soundlog.app domain will reject
# anything that isn't the production stack.
RESEND_API_KEY=
EMAIL_FROM=Soundlog <onboarding@resend.dev>

# ---------- Last.fm ----------
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=

# ---------- Discogs ----------
# Personal access token (Settings → Developers). Sent as an
# `Authorization: Discogs token=<value>` header, never a URL parameter.
DISCOGS_TOKEN=

# MusicBrainz needs no key — set a proper User-Agent instead
MUSICBRAINZ_USER_AGENT=Soundlog/0.1.0 (dev@soundlog.app)

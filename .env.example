# ---------- Core ----------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# ---------- Database ----------
DATABASE_URL=postgresql://soundlog:soundlog@localhost:5432/soundlog

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Elasticsearch ----------
ELASTICSEARCH_NODE=http://localhost:9200

# ---------- Auth ----------
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# THE APP ORIGIN — where the browser actually loads the app. One origin serves
# the SPA and /api (Vite proxies it in dev, nginx in production), so the refresh
# cookie is same-origin by construction. Also where OAuth hands the browser back.
#
# `localhost`, NOT `127.0.0.1`: browsers treat them as separate cookie origins,
# so a session started on one is invisible on the other — the app renders
# logged-out and it looks like a broken session. The provider callbacks below
# stay on 127.0.0.1 (Spotify requires a literal loopback IP) and that is safe:
# that leg sets no cookie, it mints a one-time code and redirects here.
CLIENT_URL=http://localhost:3000

# ---------- Spotify ----------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4000/api/auth/spotify/callback

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4000/api/auth/google/callback

# ---------- Resend (transactional email) ----------
# Optional. Leave blank in development: sends become a logged no-op, which is
# usually what you want locally. To exercise a real send, mint a key and use
# Resend's onboarding@resend.dev sender — the soundlog.app domain will reject
# anything that isn't the production stack.
RESEND_API_KEY=
EMAIL_FROM=Soundlog <onboarding@resend.dev>

# ---------- Last.fm ----------
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=

# ---------- Discogs ----------
# Personal access token (Settings → Developers). Sent as an
# `Authorization: Discogs token=<value>` header, never a URL parameter.
DISCOGS_TOKEN=

# MusicBrainz needs no key — set a proper User-Agent instead
MUSICBRAINZ_USER_AGENT=Soundlog/0.1.0 (dev@soundlog.app)

# ---------- Cover art proxy ----------
# Where re-encoded cover renditions are cached on disk. Regenerable from
# Release.coverUrl, so it is safe to delete at any time; the default is a
# gitignored directory under backend/. The production stack overrides this with
# a named volume (docker-compose.prod.yml).
COVER_CACHE_DIR=.cache/covers
# Hard ceiling on that directory, swept LRU-style. Default 1 GiB.
COVER_CACHE_MAX_BYTES=1073741824

# ---------- Avatars (Phase 6.2) ----------
# Where user avatars live. NOT a cache, despite sitting next to one: a cover can
# be re-fetched from the Cover Art Archive after it is evicted, whereas an
# avatar has no upstream and this is the only copy. So: `.data/`, not `.cache/`;
# no max-bytes ceiling and no LRU sweeper; and in production this is a named
# volume (prod_avatars, at /var/lib/soundlog/avatars) that the nightly backup
# archives. Deleting this directory loses user data permanently.
AVATAR_DIR=.data/avatars

# ---------- Catalog pre-warming (Phase 6.1.4) ----------
# Minutes between sweeps that finish enrichment for releases we already hold,
# most-rated first, at the lowest upstream priority tier. It never creates a
# release row — nothing is bulk-seeded (see services/prewarmService.ts).
#
# 0 DISABLES it, and that is the default on purpose: no test run, CI job or
# developer laptop should make unattended third-party calls. Production opts in.
PREWARM_INTERVAL_MINUTES=0
# Releases healed per sweep. A politeness budget, not a throughput target —
# each costs a handful of throttled MusicBrainz calls.
PREWARM_BATCH_SIZE=5

# --- Artist pre-warming (6.2e) -------------------------------------------
# The sibling of PREWARM_* for artists we do NOT hold. Warms the MusicBrainz
# caches (search, artist lookup, discography) and the cover renditions for the
# artists on the WarmTarget list, so a stranger's first search and first artist
# page are served from Redis and local disk instead of a 1 req/s throttle.
#
# It creates NO rows — not a Release, not even an Artist. See warmService.ts.
#
# 0 DISABLES it, same default and same reason as PREWARM_INTERVAL_MINUTES.
# 1440 (nightly) is the intended production setting: every MusicBrainz cache has
# a 7-day TTL, so a nightly sweep refreshes roughly the expiring seventh of the
# list — a few minutes of background work rather than a weekly half-hour cliff.
WARM_INTERVAL_MINUTES=0
# Artists warmed per sweep. A bound on how much a single night may START, not a
# throughput target: an already-warm target costs Redis reads and no upstream
# call, so this only bites when a large part of the list has expired at once.
WARM_BATCH_SIZE=50

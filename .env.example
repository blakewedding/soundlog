# ---------- Core ----------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# ---------- Database ----------
DATABASE_URL=postgresql://soundlog:soundlog@localhost:5432/soundlog

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Elasticsearch ----------
ELASTICSEARCH_NODE=http://localhost:9200

# ---------- Auth ----------
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Browser is redirected here after a successful OAuth sign-in.
# Use 127.0.0.1 (not localhost) so the whole OAuth round-trip stays on one host
# — Spotify's dashboard also requires 127.0.0.1 for loopback redirect URIs.
CLIENT_URL=http://127.0.0.1:3000

# ---------- Spotify ----------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4000/api/auth/spotify/callback

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4000/api/auth/google/callback

# ---------- Last.fm ----------
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=

# ---------- Discogs ----------
# Personal access token (Settings → Developers). Sent as an
# `Authorization: Discogs token=<value>` header, never a URL parameter.
DISCOGS_TOKEN=

# MusicBrainz needs no key — set a proper User-Agent instead
MUSICBRAINZ_USER_AGENT=Soundlog/0.1.0 (dev@soundlog.app)

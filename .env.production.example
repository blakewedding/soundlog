# Soundlog — PRODUCTION configuration template.
#
#   cp .env.production.example .env.production   # then fill in the blanks
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# Placeholders only — this file is committed. `.env.production` is not, and must
# never be (CLAUDE.md §7: secrets live in .env only, never in a ConfigMap, never
# in a URL parameter). In the cluster every value marked SECRET below belongs in
# a K8s Secret; the rest may live in the ConfigMap.
#
# Three of these are consumed by COMPOSE ITSELF (interpolated into the compose
# file), not by the backend process: POSTGRES_USER, POSTGRES_PASSWORD,
# POSTGRES_DB. That is why the boot command needs --env-file — a service-level
# `env_file:` populates a container, but interpolation reads only the file
# Compose was pointed at.

# ---------- Compose-level: the database the stack creates and connects to ----
# DATABASE_URL is DERIVED from these by docker-compose.prod.yml so the hostname
# is always the in-cluster service name. Do not set DATABASE_URL here — it is
# overridden. (In K8s: one Secret holding the assembled URL.)
POSTGRES_USER=soundlog
POSTGRES_PASSWORD=                      # SECRET · required, no default
POSTGRES_DB=soundlog

# Host port for the public edge (nginx). Not 3000 (dev web), not 8080 (dev
# Varnish), and NOT 8081 — that is Metro's default, and `pnpm dev` starts the
# Expo bundler there, so 8081 fails to bind on any machine running dev.
WEB_PORT=8090

# ---------- Core ----------
# NODE_ENV, PORT, DATABASE_URL, REDIS_URL and ELASTICSEARCH_NODE are set by
# docker-compose.prod.yml and intentionally ignored here: a .env.production
# copied from a dev .env must not be able to point the production API at a
# laptop's localhost.
#
# The public origin of the API, used in absolute URLs it generates. Behind the
# nginx edge the API is same-origin with the app, so this is the site origin.
API_BASE_URL=https://soundlog.example.com

# ---------- Auth ----------
JWT_SECRET=                             # SECRET · min 16 chars; `openssl rand -hex 32`
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# THE APP ORIGIN. One origin serves the SPA and /api (nginx proxies /api to
# Varnish to the backend), so the refresh cookie is same-origin by construction
# and there is no host to get wrong. This is also where OAuth hands the browser
# back to. It must be the scheme+host users actually type — see the cookie
# policy note in README (§ "One origin, one cookie jar").
CLIENT_URL=https://soundlog.example.com

# Custom scheme the mobile app registers, whitelisted as an OAuth deep-link
# target for expo-auth-session.
MOBILE_APP_SCHEME=soundlog

# ---------- Spotify ----------
# The redirect URI must ALSO be registered in the Spotify dashboard, or the
# provider rejects the callback with a redirect-URI mismatch. Spotify requires
# a literal loopback IP for local development (127.0.0.1, never "localhost");
# in production it is the real API origin, so that constraint disappears.
SPOTIFY_CLIENT_ID=                      # SECRET
SPOTIFY_CLIENT_SECRET=                  # SECRET
SPOTIFY_REDIRECT_URI=https://soundlog.example.com/api/auth/spotify/callback

# ---------- Google OAuth ----------
# Same rule: register this exact URI in the Google console.
GOOGLE_CLIENT_ID=                       # SECRET
GOOGLE_CLIENT_SECRET=                   # SECRET
GOOGLE_REDIRECT_URI=https://soundlog.example.com/api/auth/google/callback

# ---------- Resend (transactional email) ----------
# Sends the address-confirmation and password-reset messages.
#
# OPTIONAL, exactly like Last.fm and Discogs: with no key the app boots and
# simply does not send — verification and reset degrade to a logged no-op rather
# than a failed registration. That is deliberate, and it is what lets the stack
# be deployed and proven BEFORE the sending domain has finished verifying its
# DNS. Unverified accounts are full accounts (they can log in), so a missing key
# is a degraded launch, never a locked-out one.
#
# EMAIL_FROM must be on a domain verified in the Resend dashboard, with SPF,
# DKIM and DMARC published at Cloudflare. An unverified domain is rejected with
# a definitive 403 — a configuration error, reported as such rather than
# retried like an outage.
RESEND_API_KEY=                         # SECRET · optional; sends are skipped without it
EMAIL_FROM=Soundlog <hello@soundlog.app>

# ---------- Last.fm ----------
LASTFM_API_KEY=                         # SECRET · optional; similar artists degrade to empty
LASTFM_SHARED_SECRET=                   # SECRET · optional

# ---------- Discogs ----------
# Personal access token, sent as `Authorization: Discogs token=<value>` — a
# header, never a URL parameter. Optional: without it the Discogs half of the
# search fan-out degrades to empty.
DISCOGS_TOKEN=                          # SECRET · optional

# ---------- MusicBrainz ----------
# No key, but a DESCRIPTIVE User-Agent is mandatory (CLAUDE.md §7) — MusicBrainz
# blocks anonymous or generic agents, and the failure mode is a 503 on every
# lookup. Put a real contact address in it.
MUSICBRAINZ_USER_AGENT=Soundlog/1.0.0 ( contact@soundlog.example.com )

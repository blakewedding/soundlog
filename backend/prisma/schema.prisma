// Soundlog — Prisma schema
// Extends the build-plan schema with: review comments (threaded),
// expanded release types (mixtapes, DJ mixes, music videos),
// diary-style logging (Log), and Discogs/MusicBrainz identifiers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

/// Subscription tier. Groundwork for 6.2 — there is no billing code behind this
/// and no path that sets PRO; the settings page renders a "coming soon" row.
/// An enum rather than a string so that adding a tier is a migration someone has
/// to write, not a typo someone can persist.
enum Plan {
  FREE
  PRO
}

/// Who may read a profile and the activity hanging off it.
///
/// The column lands in 6.2a but is NOT yet enforced, and no UI writes it — every
/// row is PUBLIC, which is the pre-existing behaviour expressed explicitly.
/// Enforcement is 6.2b and has to cover BOTH stores (§5): every read in
/// routes/users.ts, feedService, and the user documents in searchService, or a
/// hidden profile is still answerable from the search index. A toggle that
/// renders before that is a promise the product does not keep.
enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  email       String   @unique
  password    String?  // null when the account is OAuth-only
  displayName String?
  bio         String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  // Null until the address is proven. A timestamp rather than a boolean: "when"
  // is strictly more information than "whether", and it costs the same column.
  // Unverified accounts are NOT blocked from signing in (Phase 6b launch
  // decision) — the UI shows a reminder instead.
  emailVerifiedAt DateTime?

  /// An address the user has asked to move to, NOT yet in effect.
  ///
  /// The change is deliberately not applied on request. `email` is the login
  /// identifier — `verifyCredentials` looks the account up by it — so writing a
  /// new address immediately means a single typo locks someone out of their own
  /// account with nothing to log in with and no address to receive a reset at.
  /// The old address keeps working until the link sent to the NEW one is
  /// clicked, which is what makes this recoverable: an unconfirmed change
  /// simply expires.
  ///
  /// Deliberately NOT unique. Two people may hold the same pending address at
  /// once; the first to confirm takes it and the second is refused at
  /// confirmation, when we can say so plainly. A unique constraint would
  /// instead fail the *request*, which leaks that the address is spoken for.
  pendingEmail String?

  // Profile links, as `[{ label, url }]`.
  //
  // Json rather than a UserLink table because this is read on every profile,
  // review card and feed row, and a join for at most five rows is a cost paid
  // on the hottest path in the app. Json rather than String[] because a custom
  // domain has no label derivable from its hostname.
  //
  // The cost is honest: this is a schemaless column in a schema-first codebase.
  // What contains it is that there is exactly ONE write path and it parses
  // through one zod schema (profileLinksSchema) — max 5 entries, https only,
  // label <= 40 chars, url <= 200. A shape that fails the parse is a 400 and
  // never reaches the column, so readers do not have to defend themselves.
  links Json @default("[]")

  plan Plan @default(FREE)

  // See the enum: present but deliberately unenforced until 6.2b.
  profileVisibility ProfileVisibility @default(PUBLIC)

  oauthAccounts      OAuthAccount[]
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  reviews       Review[]
  ratings       Rating[]
  logs          Log[]
  lists         List[]
  comments      ReviewComment[]
  reviewLikes   ReviewLike[]
  followers     Follow[]        @relation("following")
  following     Follow[]        @relation("follower")
  activity      Activity[]
}

model OAuthAccount {
  id                String  @id @default(cuid())
  userId            String
  provider          String // "spotify" | "google" | "lastfm"
  providerAccountId String
  accessToken       String?
  refreshToken      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Purpose of a VerificationToken. One model rather than two near-identical
/// ones, so the expiry / single-use / hashing rules have exactly one
/// implementation and are tested once.
enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  /// Confirming a NEW address before it becomes the account's login email.
  /// The token is sent to the pending address, so clicking it proves control of
  /// the mailbox being moved to — which is the whole point of the exercise.
  EMAIL_CHANGE
}

/// Single-use, expiring, emailed tokens.
///
/// Deliberately the same discipline as RefreshToken: only the SHA-256 hash is
/// stored, so a database leak yields nothing usable — these tokens grant
/// account access, and a password-reset token in particular IS a credential.
/// The raw value exists only in the email that carried it.
model VerificationToken {
  id         String              @id @default(cuid())
  userId     String
  purpose    VerificationPurpose
  tokenHash  String              @unique
  expiresAt  DateTime
  createdAt  DateTime            @default(now())
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Artist {
  id            String   @id @default(cuid())
  musicbrainzId String?  @unique // MB artist MBID — canonical ID
  name          String // as MusicBrainz has it — may be non-Latin (フィッシュマンズ)
  // Latin/English rendering from MB aliases or sort-name, when `name` isn't
  // Latin script. Display is "Latin (Original)"; search matches either.
  latinName     String?
  sortName      String?
  type          String? // "Person" | "Group" | ...
  area          String? // country/region name from MusicBrainz
  beginDate     String? // formed/born — MB partial dates ("1963", "1963-06-18")
  createdAt     DateTime @default(now())

  releases Release[]

  @@index([name])
}

model Label {
  id            String   @id @default(cuid())
  musicbrainzId String?  @unique // MB label MBID — canonical
  discogsId     String?  @unique // "label:N" fallback identity
  name          String
  area          String? // country/region from MusicBrainz
  founded       String? // MB partial date ("1989", "1989-05")
  createdAt     DateTime @default(now())

  releases Release[]

  @@index([name])
}

model Release {
  id           String      @id @default(cuid())
  spotifyId    String?     @unique
  musicbrainzId String?    @unique // MBID — canonical dedupe key
  discogsId    String?     @unique // namespace-qualified: "master:N" | "release:N"
  lastfmUrl    String?
  title        String
  artistName   String
  artistId     String?
  labelId      String? // primary label (first credit)
  releaseDate  DateTime?
  genres       String[]
  coverUrl     String? // tile/thumbnail rendition, proxied (/covers/w400/…)
  coverUrlLarge String? // lightbox rendition, proxied (/covers/w1200/…)
  // Raw dominant colour of the artwork as #rrggbb, sampled server-side so the
  // FIRST paint of a cover is tinted rather than a flat tile. Muting into the
  // palette stays in the web client (see services/coverTint.ts for why).
  coverColor   String?
  type         ReleaseType
  trackCount   Int?
  durationMs   Int?

  artist    Artist?    @relation(fields: [artistId], references: [id])
  label     Label?     @relation(fields: [labelId], references: [id])
  reviews   Review[]
  ratings   Rating[]
  logs      Log[]
  listItems ListItem[]

  @@index([title])
  @@index([artistName])
}

enum ReleaseType {
  ALBUM
  SINGLE
  SONG
  EP
  MIXTAPE
  DJ_MIX
  COMPILATION
  MUSIC_VIDEO
  VIDEO
}

// ---------------------------------------------------------------------------
// Logging, ratings, reviews (the Letterboxd trio)
// ---------------------------------------------------------------------------

// A diary entry: "I listened to this on this date." Multiple logs per
// release per user are allowed — relistens are the point.
model Log {
  id         String   @id @default(cuid())
  userId     String
  releaseId  String
  listenedAt DateTime @default(now())
  isRelisten Boolean  @default(false)
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  release Release @relation(fields: [releaseId], references: [id])

  @@index([userId, listenedAt])
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  releaseId String
  value     Float // 0.5–5.0 in half-star increments
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  release Release @relation(fields: [releaseId], references: [id])

  @@unique([userId, releaseId]) // one rating per release per user, DB-enforced
}

model Review {
  id               String   @id @default(cuid())
  userId           String
  releaseId        String
  content          String
  rating           Float? // optional attached rating
  containsSpoilers Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  release  Release         @relation(fields: [releaseId], references: [id])
  likes    ReviewLike[]
  comments ReviewComment[]

  @@unique([userId, releaseId]) // one review per release per user, DB-enforced
}

model ReviewLike {
  userId   String
  reviewId String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
}

// Threaded comments on reviews — one level of nesting via parentId.
model ReviewComment {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  parentId  String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  review  Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  ReviewComment?  @relation("thread", fields: [parentId], references: [id])
  replies ReviewComment[] @relation("thread")

  @@index([reviewId, createdAt])
}

// ---------------------------------------------------------------------------
// Lists
// ---------------------------------------------------------------------------

model List {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  isPublic    Boolean  @default(true)
  isRanked    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ListItem[]
}

model ListItem {
  id        String  @id @default(cuid())
  listId    String
  releaseId String
  position  Int
  note      String?

  list    List    @relation(fields: [listId], references: [id], onDelete: Cascade)
  release Release @relation(fields: [releaseId], references: [id])

  @@unique([listId, releaseId])
  @@index([listId, position])
}

// ---------------------------------------------------------------------------
// Social graph & activity
// ---------------------------------------------------------------------------

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model Activity {
  id        String       @id @default(cuid())
  userId    String
  type      ActivityType
  targetId  String
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum ActivityType {
  LOG
  REVIEW
  RATING
  LIST_CREATE
  LIST_ITEM_ADD
  COMMENT
  FOLLOW
}


// ---------------------------------------------------------------------------
// Pre-warming targets (6.2e)
// ---------------------------------------------------------------------------

/// Where a warm target came from, and the whole point of the column.
///
/// The succession is already decided: curation is a launch expedient, and once
/// real engagement exists the list becomes user-aggregated from Soundlog's own
/// ratings, logs and searches. That change must be a new WRITER and nothing
/// else — `warmService` reads `enabled` ordered by `weight` and never learns
/// which of these produced a row, so swapping curation for measurement adds an
/// aggregation job and touches no consumer.
///
/// An enum rather than a string for the Plan reason: adding a provenance is a
/// migration someone writes, not a typo someone persists.
enum WarmTargetSource {
  /// Hand-picked from the content catalogue — the underground depth that is the
  /// product's identity and that no chart will ever surface.
  CURATED
  /// Chart-derived mainstream spine: the artists a stranger tries first.
  CHART
  /// Computed from our own engagement. Nothing writes this yet, deliberately.
  AGGREGATED
}

/// An artist whose MusicBrainz caches we keep warm ahead of demand.
///
/// This table is DATA, not code: the list is edited without a deploy, and it
/// lives in Postgres rather than a file because a file in the image needs a
/// rebuild and a file on a volume is invisible to `backup-db.sh` (§5 — Postgres
/// is truth). It creates no Release and no Artist row; see `warmService`.
model WarmTarget {
  id String @id @default(cuid())

  /// MB artist MBID — the ONLY identity here (§3). There is deliberately no
  /// unique constraint on `name`: two acts share a name far more often than is
  /// comfortable, and collapsing them is the 6.2c bug. Ingestion refuses an
  /// ambiguous name rather than guessing an MBID for it.
  artistMbid String @unique

  /// Display and debug only — never matched on, never used to resolve identity.
  /// Kept so an operator reading this table sees names instead of 36-char ids.
  name String

  source  WarmTargetSource
  /// Ordering only, descending. Higher is warmed first when a sweep is bounded.
  weight  Float            @default(0)
  /// A target is disabled rather than deleted, so a decision to stop warming
  /// something stays visible and reversible.
  enabled Boolean          @default(true)

  /// When the sweep last ATTEMPTED this target — not when it last succeeded.
  /// The distinction is 6.1.5's lesson about `warmed N`: attempts and outcomes
  /// log identically unless you record them separately, so `lastResult` carries
  /// the outcome and this carries only the attempt.
  lastWarmedAt DateTime?
  /// Outcome of the last attempt, for operator diagnosis. Free-form on purpose:
  /// it is read by humans, never branched on.
  lastResult   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, weight])
}
